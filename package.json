{
  "name": "jelada-studios-site",
  "private": true,
  "description": "Static site for Jelada Studios. Only the Tailwind utility CSS needs a build step.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --watch",
    "stamp": "node scripts/stamp-assets.cjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
